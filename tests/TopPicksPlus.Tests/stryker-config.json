{
  "stryker-config": {
    "project": "TopPicksPlus.csproj",
    "mutate": [
      "**/Logic/**/*.cs",
      "**/Storage/**/*.cs"
    ],
    "test-case-filter": "FullyQualifiedName~TopPicksPlus.Tests.Logic|FullyQualifiedName~TopPicksPlus.Tests.Storage",
    "coverage-analysis": "perTest",
    "reporters": [ "html", "json", "cleartext", "progress" ],
    "thresholds": { "high": 90, "low": 80, "break": 80 }
  }
}
