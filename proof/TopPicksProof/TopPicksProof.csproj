<Project Sdk="Microsoft.NET.Sdk">

  <!-- D76, D77: the separate proof plugin. Never part of TopPicksPlus.dll; references nothing in src/. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>TopPicksProof</AssemblyName>
    <RootNamespace>TopPicksProof</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.0.0</Version>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <!-- D14: the same pinned Emby plugin SDK as the plugin. Emby supplies it at runtime. -->
    <PackageReference Include="MediaBrowser.Server.Core" Version="[4.9.1.90]" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="**/README.md" />
  </ItemGroup>

</Project>
